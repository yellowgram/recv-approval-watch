{
  "name": "recv-approval-watch",
  "version": "0.2.0",
  "description": "Deprecated: merged into l2-send-guard 1.x. This package still works but gets no fixes. See https://github.com/yellowgram/l2-safety-proxy#migrating",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "docs/fixtures/offline.expected.txt",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "docs/DEMO.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "demo:offline": "npm run build && node scripts/demo-offline.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "approval",
    "receive",
    "agent",
    "fail-closed",
    "deprecated"
  ],
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/recv-approval-watch.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/recv-approval-watch/issues"
  },
  "homepage": "https://www.yellowgram.dev/oss"
}
